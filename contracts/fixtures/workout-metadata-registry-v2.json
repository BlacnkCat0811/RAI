{
  "contract": "rai.workout.metadata_registry",
  "version": 2,
  "previousVersion": 1,
  "wireField": "metadataRegistryVersion",
  "maxKeysPerObject": 64,
  "textMaxBytes": 64,
  "syntheticOnly": true,
  "note": "Shared golden vectors for the Swift and Go Workout metadata contracts. Values are synthetic and match the native carrier shape observed on a real device; no real metadata value is reproduced here.",
  "keys": [
    {"key": "HKTimeZone", "kind": "text", "maxBytes": 128, "introducedIn": 1,
     "scopes": ["workout", "activity", "activityEvent", "workoutEvent", "route"]},
    {"key": "HKIndoorWorkout", "kind": "boolean", "introducedIn": 1,
     "scopes": ["workout", "activity", "activityEvent", "workoutEvent", "route"]},
    {"key": "HKAverageMETs", "kind": "quantity", "unit": "kcal/(kg*hr)", "introducedIn": 1,
     "scopes": ["workout", "activity", "activityEvent", "workoutEvent"]},
    {"key": "HKElevationAscended", "kind": "quantity", "unit": "m", "introducedIn": 1,
     "scopes": ["workout", "activity", "activityEvent", "workoutEvent"]},
    {"key": "HKElevationDescended", "kind": "quantity", "unit": "m", "introducedIn": 1,
     "scopes": ["workout", "activity", "activityEvent", "workoutEvent"]},
    {"key": "HKWeatherHumidity", "kind": "quantity", "unit": "1", "introducedIn": 1,
     "scopes": ["workout", "activity", "activityEvent", "workoutEvent"]},
    {"key": "HKWeatherTemperature", "kind": "quantity", "unit": "degC", "introducedIn": 1,
     "scopes": ["workout", "activity", "activityEvent", "workoutEvent"]},
    {"key": "HKAverageSpeed", "kind": "quantity", "unit": "m/s", "introducedIn": 1,
     "scopes": ["workout", "activity", "activityEvent", "workoutEvent"]},
    {"key": "HKMaximumSpeed", "kind": "quantity", "unit": "m/s", "introducedIn": 1,
     "scopes": ["workout", "activity", "activityEvent", "workoutEvent"]},
    {"key": "WOIntervalStepKeyPath", "kind": "text", "maxBytes": 64, "introducedIn": 2,
     "documented": false, "preservation": "opaque", "scopes": ["activity"]},
    {"key": "WOIntervalStepSuccessful", "kind": "signedInteger", "introducedIn": 2,
     "documented": false, "preservation": "opaque", "scopes": ["activity"]}
  ],
  "vectors": [
    {"name": "opaque_integer_valid", "scope": "activity",
     "native": {"carrier": "NSNumber:q", "cfNumberType": 4},
     "wire": {"WOIntervalStepSuccessful": 1}, "expect": "accepted"},
    {"name": "opaque_integer_negative_preserved", "scope": "activity",
     "native": {"carrier": "NSNumber:q", "cfNumberType": 4},
     "wire": {"WOIntervalStepSuccessful": -1}, "expect": "accepted",
     "note": "Sign is not interpreted: the semantics are undocumented, so the exact signed value is preserved instead of being rejected by an invented domain rule."},
    {"name": "opaque_integer_wrong_carrier_double", "scope": "activity",
     "native": {"carrier": "NSNumber:d", "cfNumberType": 6},
     "wire": {"WOIntervalStepSuccessful": 1.5}, "expect": "rejected"},
    {"name": "opaque_integer_wrong_carrier_boolean", "scope": "activity",
     "native": {"carrier": "NSNumber:c", "cfNumberType": 7},
     "wire": {"WOIntervalStepSuccessful": true}, "expect": "rejected"},
    {"name": "opaque_integer_overflow", "scope": "activity",
     "native": {"carrier": "NSNumber:q", "cfNumberType": 4},
     "wire": {"WOIntervalStepSuccessful": 9223372036854775808}, "expect": "rejected"},
    {"name": "opaque_integer_unsigned_overflow", "scope": "activity",
     "native": {"carrier": "NSNumber:Q", "cfNumberType": 5},
     "wire": {"WOIntervalStepSuccessful": 18446744073709551615}, "expect": "rejected"},
    {"name": "opaque_integer_string", "scope": "activity",
     "native": {"carrier": "String"},
     "wire": {"WOIntervalStepSuccessful": "1"}, "expect": "rejected"},
    {"name": "opaque_text_valid", "scope": "activity",
     "native": {"carrier": "String", "lengthClass": "le8", "formatClass": "token"},
     "wire": {"WOIntervalStepKeyPath": "synthetic-step-path"}, "expect": "accepted"},
    {"name": "opaque_text_empty", "scope": "activity",
     "native": {"carrier": "String", "lengthClass": "le8", "formatClass": "empty"},
     "wire": {"WOIntervalStepKeyPath": ""}, "expect": "rejected"},
    {"name": "opaque_text_oversized", "scope": "activity",
     "native": {"carrier": "String", "lengthClass": "gt128"},
     "wire": {"WOIntervalStepKeyPath": "synthetic-synthetic-synthetic-synthetic-synthetic-synthetic-synthetic-"}, "expect": "rejected"},
    {"name": "opaque_text_control_character", "scope": "activity",
     "native": {"carrier": "String"},
     "wire": {"WOIntervalStepKeyPath": "synthetic\npath"}, "expect": "rejected"},
    {"name": "opaque_text_integer_carrier", "scope": "activity",
     "native": {"carrier": "NSNumber:q"},
     "wire": {"WOIntervalStepKeyPath": 7}, "expect": "rejected"},
    {"name": "opaque_text_unicode_preserved", "scope": "activity",
     "native": {"carrier": "String"},
     "wire": {"WOIntervalStepKeyPath": "synthetic-步-1"}, "expect": "accepted",
     "note": "No Unicode normalization, no case folding, no trimming: the exact scalar sequence is preserved."},
    {"name": "opaque_integer_wrong_scope_workout", "scope": "workout",
     "native": {"carrier": "NSNumber:q", "cfNumberType": 4},
     "wire": {"WOIntervalStepSuccessful": 1}, "expect": "rejected"},
    {"name": "opaque_text_wrong_scope_event", "scope": "activityEvent",
     "native": {"carrier": "String"},
     "wire": {"WOIntervalStepKeyPath": "synthetic-step-path"}, "expect": "rejected"},
    {"name": "version1_key_at_activity_scope", "scope": "activity",
     "native": {"carrier": "String"},
     "wire": {"HKTimeZone": "Etc/UTC"}, "expect": "accepted"},
    {"name": "unknown_key", "scope": "activity",
     "native": {"carrier": "String"},
     "wire": {"synthetic_unknown_key": "synthetic"}, "expect": "rejected"},
    {"name": "unknown_key_at_workout_scope", "scope": "workout",
     "native": {"carrier": "NSNumber:q"},
     "wire": {"synthetic_unknown_key": 1}, "expect": "rejected"},
    {"name": "duplicate_metadata_key", "scope": "activity",
     "rawJSON": "{\"WOIntervalStepKeyPath\":\"synthetic-a\",\"WOIntervalStepKeyPath\":\"synthetic-b\"}",
     "expect": "rejected"},
    {"name": "metadata_object_limit", "scope": "activity",
     "syntheticKeys": 65, "expect": "rejected"}
  ]
}
