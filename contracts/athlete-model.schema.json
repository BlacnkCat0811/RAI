{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AthleteModelSnapshot",
  "$defs": {
    "ProductMetricState": {
      "type": "string",
      "enum": [
        "available",
        "limited",
        "collecting",
        "unavailable",
        "stale"
      ],
      "description": "V1 server mapping; clients preserve future string values and present a limited fallback."
    },
    "AthleteMetricLineageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataSources"
      ],
      "properties": {
        "dataSources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "AthleteMetricEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metric",
        "modelVersion",
        "payloadVersion",
        "mappingVersion",
        "state",
        "modelStatus",
        "quality",
        "confidence",
        "evidenceSupport",
        "asOf",
        "evaluationAt",
        "freshness",
        "updatedAt",
        "reasonCodes",
        "productReasonCodes",
        "lineageSummary",
        "technicalError"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "modelVersion": {
          "type": "string"
        },
        "payloadVersion": {
          "type": "string"
        },
        "mappingVersion": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ProductMetricState"
        },
        "modelStatus": {
          "type": "string"
        },
        "quality": {
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceSupport": {
          "type": "string"
        },
        "asOf": {
          "anyOf": [
            {
              "type": "integer",
              "format": "int64"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluationAt": {
          "type": "integer",
          "format": "int64"
        },
        "freshness": {
          "type": "string",
          "enum": [
            "fresh",
            "aging",
            "stale",
            "expired",
            "unknown"
          ]
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "integer",
              "format": "int64"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "productReasonCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lineageSummary": {
          "$ref": "#/$defs/AthleteMetricLineageSummary"
        },
        "technicalError": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Timestamps are UTC epoch microseconds. asOf/updatedAt remain metric-specific. Confidence is evidence support, never accuracy probability; V1 UI uses evidence labels without percentages. No UUIDs or detailed health lineage."
    },
    "AthleteMetricTrend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "unit",
        "reasonCodes"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string"
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "AthleteMetricFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "value",
        "unit"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "AthleteMetricExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "supportingFacts",
        "limitations"
      ],
      "properties": {
        "headline": {
          "type": "string"
        },
        "supportingFacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AthleteMetricFact"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Localization keys and typed facts only; no server natural-language sentence."
    },
    "TrainingLoadValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latestWorkoutLoad",
        "latestWorkoutAsOf",
        "acute",
        "chronic",
        "balance",
        "trend7",
        "knownness",
        "unit",
        "stateUnit",
        "stateModelVersion"
      ],
      "properties": {
        "latestWorkoutLoad": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "latestWorkoutAsOf": {
          "anyOf": [
            {
              "type": "integer",
              "format": "int64"
            },
            {
              "type": "null"
            }
          ]
        },
        "acute": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "chronic": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "balance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "trend7": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "knownness": {
          "type": "string"
        },
        "unit": {
          "const": "RAI_AU"
        },
        "stateUnit": {
          "const": "RAI_AU/day"
        },
        "stateModelVersion": {
          "type": "string"
        }
      },
      "description": "Recorded running stimulus. Latest workout AU, M2 acute/chronic/balance AU/day, M2 trend7 AU/day squared. Unknown is not zero; no total-body or overtraining claim."
    },
    "RunningAbilityValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "v60",
        "gamma",
        "enduranceRetention",
        "stability",
        "evidenceMode",
        "evidenceCount",
        "speedUnit",
        "scoreUnit"
      ],
      "properties": {
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "v60": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "gamma": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "enduranceRetention": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "stability": {
          "type": "string"
        },
        "evidenceMode": {
          "type": "string"
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "speedUnit": {
          "const": "m/s"
        },
        "scoreUnit": {
          "const": "score_0_100"
        }
      },
      "description": "Recent demonstrated sustained running ability, independent of VO2max. Trend absent without comparable same model/version/evidence mode results."
    },
    "ExternalVO2Value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "provider",
        "origin",
        "sampleDate",
        "externalEstimate"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "const": "mL/kg/min"
        },
        "provider": {
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sampleDate": {
          "anyOf": [
            {
              "type": "integer",
              "format": "int64"
            },
            {
              "type": "null"
            }
          ]
        },
        "externalEstimate": {
          "const": true
        }
      },
      "description": "Apple Health external estimate; never RAI measured VO2max, a laboratory ground truth, or RAI improvement."
    },
    "RecoveryComponentState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "relativeToBaseline"
      ],
      "properties": {
        "availability": {
          "type": "string"
        },
        "relativeToBaseline": {
          "type": "string"
        }
      }
    },
    "RecoveryValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "unit",
        "baselineState",
        "hrv",
        "rhr",
        "sleep"
      ],
      "properties": {
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "const": "score_0_100"
        },
        "baselineState": {
          "type": "string"
        },
        "hrv": {
          "$ref": "#/$defs/RecoveryComponentState"
        },
        "rhr": {
          "$ref": "#/$defs/RecoveryComponentState"
        },
        "sleep": {
          "$ref": "#/$defs/RecoveryComponentState"
        },
        "deviationLevel": {
          "enum": [
            "normal",
            "mild_deviation",
            "marked_deviation"
          ],
          "description": "Three-step presentation of the adverse deviation from the personal baseline; omitted without a score."
        }
      },
      "description": "Physiological recovery pressure proxy from HRV SDNN/RHR/sleep relative to personal baseline. Component states only, no raw values or z-scores."
    },
    "ReadinessValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "recoveryScore",
        "loadMultiplier",
        "recentRecordedLoad",
        "unit",
        "scope"
      ],
      "properties": {
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "recoveryScore": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "loadMultiplier": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "recentRecordedLoad": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "const": "score_0_100"
        },
        "scope": {
          "const": "running_focused"
        }
      },
      "description": "Instant running-focused state. Recovery times recent recorded running-load context; no long-term trend or mandatory training instruction."
    },
    "TrainingLoadMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope",
        "value",
        "trend",
        "explanation"
      ],
      "properties": {
        "envelope": {
          "$ref": "#/$defs/AthleteMetricEnvelope"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrainingLoadValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "trend": {
          "$ref": "#/$defs/AthleteMetricTrend"
        },
        "explanation": {
          "$ref": "#/$defs/AthleteMetricExplanation"
        }
      }
    },
    "RunningAbilityMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope",
        "value",
        "trend",
        "explanation"
      ],
      "properties": {
        "envelope": {
          "$ref": "#/$defs/AthleteMetricEnvelope"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunningAbilityValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "trend": {
          "$ref": "#/$defs/AthleteMetricTrend"
        },
        "explanation": {
          "$ref": "#/$defs/AthleteMetricExplanation"
        }
      }
    },
    "ExternalVO2Metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope",
        "value",
        "trend",
        "explanation"
      ],
      "properties": {
        "envelope": {
          "$ref": "#/$defs/AthleteMetricEnvelope"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalVO2Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "trend": {
          "$ref": "#/$defs/AthleteMetricTrend"
        },
        "explanation": {
          "$ref": "#/$defs/AthleteMetricExplanation"
        }
      }
    },
    "RecoveryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope",
        "value",
        "trend",
        "explanation"
      ],
      "properties": {
        "envelope": {
          "$ref": "#/$defs/AthleteMetricEnvelope"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "trend": {
          "$ref": "#/$defs/AthleteMetricTrend"
        },
        "explanation": {
          "$ref": "#/$defs/AthleteMetricExplanation"
        }
      }
    },
    "ReadinessMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope",
        "value",
        "trend",
        "explanation"
      ],
      "properties": {
        "envelope": {
          "$ref": "#/$defs/AthleteMetricEnvelope"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadinessValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "trend": {
          "$ref": "#/$defs/AthleteMetricTrend"
        },
        "explanation": {
          "$ref": "#/$defs/AthleteMetricExplanation"
        }
      }
    },
    "AthleteProductAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "stackID",
        "version"
      ],
      "properties": {
        "channel": {
          "enum": [
            "active",
            "candidate"
          ]
        },
        "stackID": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "AthleteModelSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "asOf",
        "evaluationAt",
        "datasetRevision",
        "timezone",
        "calendarDate",
        "assignment",
        "responseState",
        "presentationOrder",
        "notices",
        "trainingLoad",
        "runningAbility",
        "externalVO2Max",
        "physiologicalRecovery",
        "trainingReadiness"
      ],
      "properties": {
        "schemaVersion": {
          "const": "rai.athlete_model/1"
        },
        "asOf": {
          "type": "integer",
          "format": "int64"
        },
        "evaluationAt": {
          "type": "integer",
          "format": "int64"
        },
        "datasetRevision": {
          "type": "integer",
          "format": "int64"
        },
        "timezone": {
          "type": "string"
        },
        "calendarDate": {
          "type": "string",
          "format": "date"
        },
        "assignment": {
          "$ref": "#/$defs/AthleteProductAssignment"
        },
        "responseState": {
          "enum": [
            "complete_response",
            "partial_response"
          ]
        },
        "presentationOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trainingLoad": {
          "$ref": "#/$defs/TrainingLoadMetric"
        },
        "runningAbility": {
          "$ref": "#/$defs/RunningAbilityMetric"
        },
        "externalVO2Max": {
          "$ref": "#/$defs/ExternalVO2Metric"
        },
        "physiologicalRecovery": {
          "$ref": "#/$defs/RecoveryMetric"
        },
        "trainingReadiness": {
          "$ref": "#/$defs/ReadinessMetric"
        }
      },
      "description": "M7 read-only product contract, not a new model or health status. asOf is the dataset-view evaluation anchor, not a fabricated common metric generation time. No public endpoint is enabled in M7; active legacy remains unchanged."
    },
    "AthleteModelCandidateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateOnly",
        "snapshot"
      ],
      "properties": {
        "candidateOnly": {
          "const": true
        },
        "snapshot": {
          "$ref": "#/$defs/AthleteModelSnapshot"
        }
      },
      "description": "Administrative synthetic/testing transport only. Default model-stack inspect is redacted; full values require explicit synthetic-test-values. Never registered with httpapi."
    },
    "ModelPromotionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelVersion",
        "engineeringComplete",
        "realDeviceAccepted",
        "physiologicalValidated",
        "productContractAccepted",
        "rollbackReady",
        "promotable",
        "blockingReasons",
        "requiredAcceptance",
        "rollbackPlan"
      ],
      "properties": {
        "modelVersion": {
          "type": "string"
        },
        "engineeringComplete": {
          "type": "boolean"
        },
        "realDeviceAccepted": {
          "type": "boolean"
        },
        "physiologicalValidated": {
          "type": "boolean"
        },
        "productContractAccepted": {
          "type": "boolean"
        },
        "rollbackReady": {
          "type": "boolean"
        },
        "promotable": {
          "type": "boolean"
        },
        "blockingReasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredAcceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rollbackPlan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Read-only promotion plan. All five promotable=false; engineering complete is not product activated. External VO2max requires device/source acceptance rather than RAI physiological formula validation."
    }
  }
}
