# Local synthetic development only. Never use these values in production.
# Run the API or worker on the host only after starting a dedicated database
# with an appropriate loopback port mapping and applying the migrations.
RAI_DATABASE_URL=postgres://rai_dev:development-only@127.0.0.1:55432/rai_dev?sslmode=disable
RAI_LISTEN_ADDR=127.0.0.1:8080
# Alternative to RAI_DATABASE_URL: RAI_DATABASE_URL_FILE=/path/to/secret
